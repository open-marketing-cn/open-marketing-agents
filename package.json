{
  "name": "open-marketing",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "面向中国营销人的本地 Agent 商店，由 Interflow 发起。",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "safety": "node scripts/safety-scan.mjs",
    "verify": "npm run safety && npm run check && npm test && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@lucide/svelte": "^1.31.0",
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.15.0",
    "svelte": "^5.28.0",
    "svelte-check": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
