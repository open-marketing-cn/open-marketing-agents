{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-marketing.cn/schemas/skill-catalog.schema.json",
  "title": "Open Marketing Skill Catalog Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "titleZh", "originalName", "summaryZh", "growthStage", "workspace",
    "featured", "visibility", "discoveredFrom", "card",
    "audiences", "useCases", "inputs", "outputs", "promptExamples", "humanGate",
    "cannotInfer", "channels", "source", "installation", "validation", "relatedSkillIds"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "titleZh": { "type": "string", "minLength": 4 },
    "originalName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summaryZh": { "type": "string", "minLength": 10 },
    "growthStage": { "const": "zero_to_one" },
    "workspace": { "enum": ["insights", "strategy", "creative", "media", "operations"] },
    "categoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "comparisonGroupId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "methodType": { "type": "string", "minLength": 2 },
    "practiceLevel": { "enum": ["discovered", "source_verified", "practiced", "replicated", "best_practice"] },
    "featured": { "type": "boolean" },
    "visibility": { "enum": ["public", "candidate", "paused_internal", "withdrawn"] },
    "discoveredFrom": { "$ref": "#/$defs/nonEmptyStringArray" },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcomeZh", "previewImage", "previewLicense"],
      "properties": {
        "outcomeZh": { "type": "string", "minLength": 10 },
        "previewImage": { "type": ["string", "null"] },
        "previewLicense": { "type": ["string", "null"] }
      }
    },
    "audiences": { "$ref": "#/$defs/nonEmptyStringArray" },
    "useCases": { "$ref": "#/$defs/nonEmptyStringArray" },
    "inputs": { "$ref": "#/$defs/nonEmptyStringArray" },
    "outputs": { "$ref": "#/$defs/nonEmptyStringArray" },
    "promptExamples": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 8 } },
    "humanGate": { "type": "string", "minLength": 8 },
    "cannotInfer": { "$ref": "#/$defs/nonEmptyStringArray" },
    "channels": { "$ref": "#/$defs/nonEmptyStringArray" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo", "path", "commit", "author", "license", "checkedAt"],
      "properties": {
        "type": { "enum": ["upstream", "adapted", "original"] },
        "repo": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "author": { "type": "string", "minLength": 2 },
        "authorUrl": { "type": "string", "format": "uri" },
        "avatarUrl": { "type": "string" },
        "license": { "type": "string", "minLength": 2 },
        "checkedAt": { "type": "string", "format": "date" },
        "githubStars": { "type": "integer", "minimum": 0 },
        "githubStarsCheckedAt": { "type": "string", "format": "date" },
        "upstreamName": { "type": "string" },
        "upstreamRepo": { "type": "string", "format": "uri" },
        "upstreamPath": { "type": "string" },
        "upstreamCommit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "upstreamAuthor": { "type": "string" },
        "changesZh": { "type": "string" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claudeCode"],
      "properties": {
        "codex": { "type": "string", "minLength": 8 },
        "claudeCode": { "type": "string", "minLength": 8 },
        "download": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "installation", "practice"],
      "properties": {
        "spec": { "$ref": "#/$defs/validation" },
        "installation": { "$ref": "#/$defs/validation" },
        "practice": { "$ref": "#/$defs/validation" }
      }
    },
    "practiceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseTitleZh", "contextZh", "inputZh", "outputZh", "evidenceUrl",
        "practitionerRole", "attributionZh", "howToUseZh", "setupZh",
        "expectedOutputZh", "pitfallsZh", "bestPracticesZh", "remixZh",
        "scenariosZh", "boundaryZh", "notForZh", "depthPathZh"
      ],
      "properties": {
        "caseTitleZh": { "type": "string", "minLength": 4 },
        "contextZh": { "type": "string", "minLength": 8 },
        "inputZh": { "type": "string", "minLength": 8 },
        "outputZh": { "type": "string", "minLength": 8 },
        "evidenceUrl": { "type": "string", "format": "uri" },
        "practitionerRole": { "type": "string", "minLength": 2 },
        "attributionZh": { "type": "string", "minLength": 4 },
        "howToUseZh": { "type": "string", "minLength": 8 },
        "setupZh": { "type": "string", "minLength": 8 },
        "expectedOutputZh": { "type": "string", "minLength": 8 },
        "pitfallsZh": { "$ref": "#/$defs/nonEmptyStringArray" },
        "bestPracticesZh": { "$ref": "#/$defs/nonEmptyStringArray" },
        "remixZh": { "type": "string", "minLength": 8 },
        "scenariosZh": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 8 } },
        "boundaryZh": { "type": "string", "minLength": 8 },
        "notForZh": { "$ref": "#/$defs/nonEmptyStringArray" },
        "depthPathZh": { "type": "string", "minLength": 8 }
      }
    },
    "comparisonProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningCurve", "outputConsistency", "flexibility", "operatorDependency",
        "materialDependency", "workflowCompleteness", "bestForZh", "notForZh"
      ],
      "properties": {
        "learningCurve": { "$ref": "#/$defs/comparisonScale" },
        "outputConsistency": { "$ref": "#/$defs/comparisonScale" },
        "flexibility": { "$ref": "#/$defs/comparisonScale" },
        "operatorDependency": { "$ref": "#/$defs/comparisonScale" },
        "materialDependency": { "$ref": "#/$defs/comparisonScale" },
        "workflowCompleteness": { "$ref": "#/$defs/comparisonScale" },
        "bestForZh": { "$ref": "#/$defs/nonEmptyStringArray" },
        "notForZh": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "comparisonEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "summaryZh", "checkedAt"],
        "properties": {
          "type": { "enum": ["publisher", "maintainer_test", "community_case", "inference"] },
          "summaryZh": { "type": "string", "minLength": 8 },
          "checkedAt": { "type": "string", "format": "date" },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      }
    },
    "submittedAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "relatedSkillIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/properties/id" } }
  },
  "$defs": {
    "comparisonScale": { "enum": ["low", "medium", "high"] },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "noteZh"],
      "properties": {
        "status": { "enum": ["passed", "pending", "failed"] },
        "checkedAt": { "type": "string", "format": "date" },
        "noteZh": { "type": "string", "minLength": 4 }
      }
    }
  }
}
