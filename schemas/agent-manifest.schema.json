{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-marketing.local/schemas/agent-manifest.schema.json",
  "title": "Open Marketing AgentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "name",
    "workspace",
    "status",
    "task",
    "requiredInputs",
    "dataSources",
    "outputs",
    "cannotInfer",
    "humanGate",
    "missingInputBehavior",
    "permissions",
    "validation",
    "sources"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "kind": { "const": "agent" },
    "version": { "type": "string" },
    "name": { "type": "string", "minLength": 2 },
    "workspace": { "enum": ["insights", "strategy", "creation", "adaptation", "delivery", "performance"] },
    "status": { "enum": ["cocreating", "pending_validation", "installable"] },
    "task": { "type": "string", "minLength": 10 },
    "requiredInputs": { "$ref": "#/$defs/nonEmptyStrings" },
    "dataSources": { "$ref": "#/$defs/nonEmptyStrings" },
    "outputs": { "$ref": "#/$defs/nonEmptyStrings" },
    "cannotInfer": { "$ref": "#/$defs/nonEmptyStrings" },
    "humanGate": { "type": "string", "minLength": 8 },
    "missingInputBehavior": { "type": "string", "minLength": 8 },
    "channels": { "$ref": "#/$defs/nonEmptyStrings" },
    "industries": { "$ref": "#/$defs/nonEmptyStrings" },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
    "bundledSkills": { "type": "array" },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
    "sources": { "type": "array", "minItems": 1 }
  },
  "$defs": {
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "permission": {
      "type": "object",
      "required": ["id", "label", "detail", "required"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "detail": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["role", "industry", "task", "date", "conclusion", "contentVersion", "target"],
      "properties": {
        "role": { "type": "string" },
        "industry": { "type": "string" },
        "task": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "conclusion": { "type": "string" },
        "contentVersion": { "type": "string" },
        "target": { "const": "Codex" }
      }
    }
  }
}
